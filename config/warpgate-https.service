[Unit]
Description=Caddy HTTPS for Warpgate
After=network-online.target warpgate-gateway.service
Wants=network-online.target

[Service]
User=wg-https
Group=wg-https
Environment=XDG_DATA_HOME=/opt/warpgate-gateway/caddy/data
Environment=XDG_CONFIG_HOME=/opt/warpgate-gateway/caddy/config
ExecStart=/opt/warpgate-gateway/bin/caddy run --config /opt/warpgate-gateway/public/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/warpgate-gateway/caddy
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
TasksMax=128
MemoryMax=128M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
